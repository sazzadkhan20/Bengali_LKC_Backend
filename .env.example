POSTGRES_DB=bengali_lkc
POSTGRES_USER=lkc_admin
POSTGRES_PASSWORD=lkc_secure_change_me
POSTGRES_PORT=5433

API_PORT=8080
SPRING_PROFILES_ACTIVE=local

JWT_SECRET=BengaliLKC-DevOnly-ChangeThisSecretKey-32charsMin!!
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
JWT_ACCESS_TTL_MINUTES=60
JWT_REFRESH_TTL_DAYS=7

SEED_DEMO_USERS=true
IMPORT_LEXICON_XML=false
DEMO_EXPOSE_SECRETS=true

# Gmail SMTP (use a Google App Password, not your normal Gmail password)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=yourgmail@gmail.com
MAIL_PASSWORD=your-16-char-app-password
MAIL_FROM=yourgmail@gmail.com
MAIL_FROM_NAME=Bengali LKC (No Reply)
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true

# Used when running the API from IntelliJ / Gradle (host → Docker Postgres)
DB_URL=jdbc:postgresql://localhost:5433/bengali_lkc
DB_USERNAME=lkc_admin
DB_PASSWORD=lkc_secure_change_me
