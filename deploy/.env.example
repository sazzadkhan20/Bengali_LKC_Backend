# Copy to /opt/bengali-lkc/.env on the server (NOT into git) and fill in every value.
#   cp /opt/bengali-lkc/backend/deploy/.env.example /opt/bengali-lkc/.env && chmod 600 /opt/bengali-lkc/.env
# Wrap values in single quotes when they contain $, #, spaces or quotes.

# ---- Public address -------------------------------------------------------
# Your DuckDNS (or own) domain, without https://
DOMAIN=benlkc.duckdns.org
# Let's Encrypt expiry notices go here
LETSENCRYPT_EMAIL=benlkc2026@gmail.com

# ---- Docker images (built by GitHub Actions) ------------------------------
# ghcr.io/<your GitHub username, lowercase>
IMAGE_REGISTRY=ghcr.io/sazzadkhan20

# ---- Database (created on first start; keep these forever) ----------------
POSTGRES_DB=bengali_lkc
POSTGRES_USER=lkc_admin
# openssl rand -base64 32 | tr -d '/+=' 
POSTGRES_PASSWORD=

# ---- Security -------------------------------------------------------------
# openssl rand -base64 48   (the API refuses to start without a strong value)
JWT_SECRET=

# ---- Email (Gmail app password: Google Account > Security > App passwords) -
MAIL_USERNAME=benlkc2026@gmail.com
MAIL_PASSWORD=
MAIL_FROM=benlkc2026@gmail.com
MAIL_FROM_NAME='Bengali LKC (No Reply)'

# ---- First Platform Architect --------------------------------------------
# Created once, on the first start against an empty database. Later deploys never change it,
# so after the first login you may delete the password line from this file.
LKC_INITIAL_ARCHITECT_USERNAME=benlkc26
LKC_INITIAL_ARCHITECT_EMAIL=benlkc2026@gmail.com
LKC_INITIAL_ARCHITECT_NAME='Bengali LKC'
LKC_INITIAL_ARCHITECT_PASSWORD=

# ---- Optional: Google reCAPTCHA v3 for the public application form --------
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# ---- Optional: memory (defaults suit a 1 GB server; raise on a bigger one) -
# BACKEND_JAVA_OPTS='-XX:+UseSerialGC -Xms128m -Xmx320m -XX:MaxMetaspaceSize=192m -XX:ReservedCodeCacheSize=64m -Xss512k'
# FRONTEND_NODE_OPTIONS='--max-old-space-size=256'
# DB_POOL_SIZE=8
